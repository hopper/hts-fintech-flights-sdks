using System.Net;

namespace Hopper.Fintech.Flights;

public sealed class SpreedlyException : Exception
{
    internal SpreedlyException(HttpStatusCode statusCode, string? attribute, string? key, string message)
        : base(message)
    {
        StatusCode = statusCode;
        Attribute = attribute;
        Key = key;
    }

    public HttpStatusCode StatusCode { get; }

    public string? Attribute { get; }

    public string? Key { get; }
}
