using System.Reflection;

namespace Hopper.Fintech.Flights;

internal static class SdkVersion
{
    internal static readonly string UserAgent = "hts-fintech-flights-csharp/" + Resolve();

    private static string Resolve() =>
        typeof(SdkVersion).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion.Split('+')[0]
        ?? "dev";
}
