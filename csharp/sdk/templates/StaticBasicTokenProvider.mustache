using Hopper.Fintech.Flights.Spreedly;
using Hopper.Fintech.Flights.Spreedly.Client;

namespace Hopper.Fintech.Flights;

internal sealed class StaticBasicTokenProvider : TokenProvider<BasicToken>
{
    private readonly BasicToken _token;

    public StaticBasicTokenProvider(TokenContainer<BasicToken> container)
    {
        _token = container.Tokens.Single();
    }

    protected internal override ValueTask<BasicToken> GetAsync(string header = "", CancellationToken cancellation = default) =>
        ValueTask.FromResult(_token);
}
